def qc_seismik(data, ambang_offset):
    laporan = {}
    for survey in data:
        survey_id = survey['survey_id']
        ok_traces = 0
        bad_traces = 0
        
        # Initialize a list to hold traces with their QC flags
        qc_traces = []

        for trace in survey['traces']:
            if trace['offset'] > ambang_offset:
                trace['QC_flag'] = "BAD"
                bad_traces += 1
            else:
                trace['QC_flag'] = "OK"
                ok_traces += 1
            qc_traces.append(trace)

        laporan[survey_id] = {
            "total_ok_traces": ok_traces,
            "total_bad_traces": bad_traces,
            "all_traces_with_qc_flag": qc_traces # Optional: include detailed trace info
        }
    return laporan

