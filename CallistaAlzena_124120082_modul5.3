import matplotlib.pyplot as plt

# Data Vp dan Densitas
densitas = [2.0, 2.1, 2.15, 2.3, 2.4, 2.5, 2.55, 2.6]
vp = [2100, 2300, 2400, 2700, 2900, 3100, 3150, 3250]

# Buat scatter plot
plt.figure(figsize=(10, 6))
plt.scatter(densitas, vp, color='blue', marker='o')

# Beri label sumbu
plt.xlabel('Densitas (g/cm^3)')
plt.ylabel('Kecepatan Gelombang P (Vp) (m/s)')

# Beri judul
plt.title('Hubungan antara Vp dan Densitas')

# Tampilkan grid
plt.grid(True)

# Tampilkan plot
plt.show()
