# Meminta input jari-jari dari pengguna
jari_jari_str = input("Masukkan jari-jari lingkaran: ")

# Mengubah input menjadi float
try:
    jari_jari = float(jari_jari_str)
except ValueError:
    print("Input tidak valid. Harap masukkan angka.")
else:
    # Menetapkan nilai Pi
    pi = 3.14

    # Menghitung luas lingkaran
    luas = pi * (jari_jari ** 2)

    # Menampilkan hasil
    print(f"Luas lingkaran dengan jari-jari {jari_jari} adalah {luas}")
